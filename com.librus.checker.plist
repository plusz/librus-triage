<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.librus.checker</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/venv/bin/python3</string>
        <string>__PROJECT_DIR__/librus_checker.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <!-- run every hour -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <!-- run once at load/login so the state file gets seeded -->
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/checker.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/checker.err</string>
</dict>
</plist>
