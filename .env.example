# ---- Librus credentials (your Synergia login) ----
LIBRUS_LOGIN=
LIBRUS_PASS=

# ---- Notifications ----
# Comma-separated: macos, ntfy, email, telegram
NOTIFY_METHOD=macos

# ntfy.sh push to your phone (optional) — pick a hard-to-guess topic name
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Email via SMTP. For Gmail use an "app password" (not your normal password):
# myaccount.google.com/apppasswords  (needs 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Telegram bot. Create via @BotFather -> TELEGRAM_BOT_TOKEN,
# then message the bot and read your chat id from:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# On first run mark all existing messages as seen (no notification flood). Set false to notify for everything.
SEED_ON_FIRST_RUN=true

# ---- Triage rules (applied before/after AI, deterministic) ----
# Senders that must ALWAYS produce a notification (comma-separated, substring of sender name)
IMPORTANT_SENDERS=
# Senders that never produce a notification (newsletters, auto-confirmations)
IGNORED_SENDERS=e-Usprawiedliwienia

# ---- AI summary ----
# Set true to auto-summarize each new message in the notification.
# WARNING: fetching full message body marks it as read in Librus.
SUMMARIZE_ENABLED=false

# Provider: basal (local decision server), ollama (local generator) or openai (remote)
AI_PROVIDER=basal

# basal-serve 2.2 — start with:
#   ./basal-env/bin/basal-serve --model Remek/basal-2.0-mini-MLX-8bit --mode mlx --port 8000
BASAL_HOST=http://localhost:8000

# Ollama (optional, for summaries)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Remote OpenAI-compatible API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
